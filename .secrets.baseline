default_stages: [pre-commit]
fail_fast: false

repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.14.0
    hooks:
      - id: ruff
        name: Ruff Python security rules (Bandit S)
        args: ["--select=S", "--ignore=S101,S104,S105,S106,S110,S603,S607"]
        types: [python]

  - repo: https://github.com/Yelp/detect-secrets
    rev: v1.5.0
    hooks:
      - id: detect-secrets
        name: detect-secrets staged-file secret scan
        args: [--baseline, .secrets.baseline]
        exclude: ^\.secrets\.baseline$

  - repo: local
    hooks:
      - id: pip-audit-all-requirements
        name: pip-audit Python dependency manifests
        entry: python scripts/security/run_pip_audit.py
        language: python
        additional_dependencies: [pip-audit==2.10.1]
        pass_filenames: false
        always_run: true
        require_serial: true